//cargo boxes

spriteset(spriteset_cargo_box_curtainside_8L, "gfx/cargo_box_8L.png") {
	template_2cc_std(1, 1)
}


//prime mover gfx switch

switch (FEAT_ROADVEHS, SELF, switch_primemover_majestic_ui, getbits(extra_callback_info1, 0, 8)) {
	0x10..0xFF: spriteset_primemover_majestic_ui;
	spriteset_primemover_majestic;
}

	template_2cc_dolly(1, 64)
}

spriteset(spriteset_dolly_3A_ui, "gfx/dollies.png") {
	template_2cc_ui(1, 64)
}

//trailer chassis

spriteset(spriteset_chassis_A_8L_2AS, "gfx/chassis_A_8L.png") {
	template_2cc_std(1, 1)
}

spriteset(spriteset_chassis_A_8L_2A, "gfx/chassis_A_8L.png") {
	template_2cc_std(1, 32)
}

spriteset(spriteset_chassis_A_8L_3A, "gfx/chassis_A_8L.png") {
	template_2cc_std(1, 64)

//spritesets

//rigids




//prime movers

spriteset(spriteset_primemover_majestic, "gfx/majestic.png") {
	template_2cc_primemover(1, 1)
}

spriteset(spriteset_primemover_majestic_ui, "gfx/majestic.png") {
	template_2cc_primemover_ui(1, 1)
}

//dollies

spriteset(spriteset_dolly_1A, "gfx/dollies.png") {
	template_2cc_dolly(1, 1)
}

spriteset(spriteset_dolly_1A_ui, "gfx/dollies.png") {
	template_2cc_ui(1, 1)
}

spriteset(spriteset_dolly_2A, "gfx/dollies.png") {
	template_2cc_dolly(1, 32)
}

spriteset(spriteset_dolly_2A_ui, "gfx/dollies.png") {
	template_2cc_ui(1, 32)
}

